@Обработчик
метод ПроверитьНаличиеКлючейДоступа(
    Ключи: ЧитаемыйМассив<КонтрактныйАвтоматическийКлюч.Объект>,
    Пользователи: ЧитаемыйМассив<Пользователи.Ссылка>
): ЧитаемоеСоответствие<КонтрактныйАвтоматическийКлюч.Объект, ЧитаемаяКоллекция<Пользователи.Ссылка>>
    знч ПользователиПоКлючам = <КонтрактныйАвтоматическийКлюч.Объект, ЧитаемаяКоллекция<Пользователи.Ссылка>>{:}
    для Ключ из Ключи
        ПользователиПоКлючам.Вставить(Ключ, Пользователи)
    ;
    возврат ПользователиПоКлючам
;
