метод ВыдатьКонтрактныйКлюч(ПользователиДляВыдачи: ЧитаемаяКоллекция<Пользователи.Ссылка>)
    знч ЭкземплярКонтрактногоКлюча = новый КонтрактныйРучнойКлюч.Объект()
    ЭкземплярКонтрактногоКлюча.Выдать(ПользователиДляВыдачи)
;

метод ОтозватьКонтрактныйКлюч(ПользователиДляОтзыва: ЧитаемаяКоллекция<Пользователи.Ссылка>? = Неопределено)
    знч ЭкземплярКонтрактногоКлюча = новый КонтрактныйРучнойКлюч.Объект()
    ЭкземплярКонтрактногоКлюча.Отозвать(ПользователиДляОтзыва)
    КонтрактныйРучнойКлюч.ОтозватьКлючи(ПользователиДляОтзыва)
;

метод ВыдатьКонтрактныеКлючиПакетом(ПользователиДляВыдачи: ЧитаемаяКоллекция<Пользователи.Ссылка>)
    знч ЭкземплярКонтрактногоКлюча = новый КонтрактныйРучнойКлюч.Объект()
    знч ПользователиПоКлючам = <КлючДоступа.Объект, ЧитаемаяКоллекция<Пользователи.Ссылка>>{
        ЭкземплярКонтрактногоКлюча: ПользователиДляВыдачи
    }
    Пользователи.ВыдатьКлючиДоступа(ПользователиПоКлючам)
;
