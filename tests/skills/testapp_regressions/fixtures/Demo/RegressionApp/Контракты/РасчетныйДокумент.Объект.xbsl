@Обработчик
метод ПередЗаписью(
    До: РасчетныйДокумент.Данные,
    ПараметрыЗаписи: РасчетныйДокумент.ПараметрыЗаписи)
    если Автор == Неопределено
        Автор = "Regression TestApp"
    ;

    пер СуммаДокумента = 0
    для Строка из Строки
        Строка.Сумма = Строка.Количество * Строка.Цена
        СуммаДокумента = СуммаДокумента + Строка.Сумма
    ;
    Сумма = СуммаДокумента
;
