<?xml version="1.0" encoding="UTF-8"?>
<wsdl:definitions
    xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
    xmlns:tns="urn:orders"
    xmlns:types="urn:orders:types"
    xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema"
    name="OrdersService"
    targetNamespace="urn:orders">
    <wsdl:types>
        <xsd:schema targetNamespace="urn:orders">
            <xsd:import namespace="urn:orders:types" schemaLocation="КлиентЗаказов.Xsd.1"/>
        </xsd:schema>
    </wsdl:types>
    <wsdl:message name="GetOrderRequest">
        <wsdl:part name="parameters" element="types:GetOrderRequest"/>
    </wsdl:message>
    <wsdl:message name="GetOrderResponse">
        <wsdl:part name="parameters" element="types:GetOrderResponse"/>
    </wsdl:message>
    <wsdl:portType name="OrdersPort">
        <wsdl:operation name="GetOrder">
            <wsdl:input message="tns:GetOrderRequest"/>
            <wsdl:output message="tns:GetOrderResponse"/>
        </wsdl:operation>
    </wsdl:portType>
    <wsdl:binding name="OrdersBinding" type="tns:OrdersPort">
        <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
        <wsdl:operation name="GetOrder">
            <soap:operation soapAction="urn:orders:GetOrder"/>
            <wsdl:input>
                <soap:body use="literal"/>
            </wsdl:input>
            <wsdl:output>
                <soap:body use="literal"/>
            </wsdl:output>
        </wsdl:operation>
    </wsdl:binding>
    <wsdl:service name="OrdersService">
        <wsdl:port binding="tns:OrdersBinding" name="OrdersPort">
            <soap:address location="https://partner.example/soap/orders"/>
        </wsdl:port>
    </wsdl:service>
</wsdl:definitions>
